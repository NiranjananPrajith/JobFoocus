# Dependencies
node_modules/
.pnpm-store/

# Next.js build output
.next/
out/

# Build artifacts
# Note: public/extensions/build/jobfoocus-extension.zip is intentionally NOT ignored —
# the /extension-install page links directly to the packaged zip at
# /extensions/build/jobfoocus-extension.zip, so it must be deployed
# to Vercel for the install flow to work. The versioned filename
# (jobfoocus-extension-v{version}.zip) is gitignored to avoid
# accumulating stale historical builds in the repo.
public/pdf-worker/
extension/build/
public/extensions/build/jobfoocus-extension-v*.zip

# Generated job application documents stored locally
/applications/

# Environment files — contain secrets, never commit
.env
.env*.local
.env.production
.env.staging

# Package manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

