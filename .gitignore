# Dependencies
node_modules/

# Next.js build output
.next/
out/

# Build artifacts
# Note: public/extensions/build/*.zip is intentionally NOT ignored —
# the /extension-install page links directly to the packaged zip at
# /extensions/build/jobfoocus-extension.zip, so it must be deployed
# to Vercel for the install flow to work. The versioned filename
# (jobfoocus-extension-v{version}.zip) is gitignored to avoid
# accumulating stale historical builds in the repo.
public/pdf-worker/
extension/build/
public/extensions/build/jobfoocus-extension-v*.zip

# Generated job application documents stored locally (not Next.js API routes)
# Ignores generated application data at project root level only
/applications/

# OS files
.DS_Store
Thumbs.db

# TypeScript build cache
*.tsbuildinfo
tsconfig.tsbuildinfo

# Environment — all .env files contain secrets, never commit
.env
.env.local

# HyperFrames video compositions
/video/

# Media assets (promo videos, rendered MP4s, project sources)
# Each video lives in its own subfolder, e.g. /media/ad002_privacy-promo/
/media/

# Claude
.claude

# Ignored directories (reference docs, dev scripts, and Supabase migrations)
/ref/
/scripts/
/supabase/

