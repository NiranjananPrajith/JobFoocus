# JobFoocus environment variables
# Copy to .env and fill in values.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenCode ZEN (DeepSeek V4 Flash Free)
OPENCODE_ZEN_API_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_MAX=
STRIPE_PRICE_ID_PRO_EUR=
STRIPE_PRICE_ID_MAX_EUR=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_ID_PRO=
RAZORPAY_PLAN_ID_MAX=

# Google OAuth (for magic link)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Meta Conversions API (from Meta Events Manager → Settings → Access Tokens)
META_ACCESS_TOKEN=
