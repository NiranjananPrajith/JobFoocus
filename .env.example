# JobFoocus environment variables
# Copy to .env and fill in values.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenRouter (LLM Gateway)
OPENROUTER_API_KEY=
LLM_MODEL=google/gemini-3.5-flash-lite

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_MAX=
STRIPE_PRICE_ID_PRO_EUR=
STRIPE_PRICE_ID_MAX_EUR=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_ID_PRO=
RAZORPAY_PLAN_ID_MAX=

# Google OAuth (for magic link)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Meta Conversions API & Pixel
META_ACCESS_TOKEN=
NEXT_PUBLIC_META_PIXEL_ID=

# Microsoft Clarity
NEXT_PUBLIC_MICROSOFT_CLARITY_ID=

