# Public OAuth2 Client IDs - Safe to share/commit
# These are public identifiers, NOT secrets.
# Register your own OAuth apps at each provider to get these values.

# Google Drive OAuth2 Client ID (from Google Cloud Console)
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com

# Microsoft OneDrive OAuth2 Client ID (from Azure App Registrations)
ONEDRIVE_CLIENT_ID=YOUR_ONEDRIVE_CLIENT_ID

# Dropbox OAuth2 Client ID (from Dropbox App Console)
DROPBOX_CLIENT_ID=YOUR_DROPBOX_CLIENT_ID
